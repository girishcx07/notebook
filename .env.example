# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# The database URL is used to connect to your PostgreSQL database.
DATABASE_URL="postgresql://postgres:password@localhost:5433/acme"

# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# ── Runtime / URLs ────────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT="3001"
PUBLIC_WEB_URL="http://localhost:3000"
PUBLIC_SERVER_URL="http://localhost:3001"
API_URL="http://localhost:3000"

# ── Embeddable Modules / SDK ──────────────────────────────────────────────────
# Comma-separated origins that can call the API from iframe-based embeds.
ALLOWED_EMBED_ORIGINS=""

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Sign up at https://resend.com to get your API key (free tier: 3k emails/mo)
RESEND_API_KEY='re_your_api_key_here'
# "From" address shown in emails.
# Use "onboarding@resend.dev" for testing (note: Resend will flag mismatched localhost vs resend.dev URLs in spam checks).
# For production use: "Acme <hello@yourdomain.com>" (avoid "no-reply" to improve deliverability)
EMAIL_FROM='Acme <onboarding@resend.dev>'

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL="info"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ── Cloudflare Tunnels ────────────────────────────────────────────────────────
# Get this from your Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
TUNNEL_TOKEN=""
